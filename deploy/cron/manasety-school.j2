# SAAS-043 - the daily cron-tick (subscriptions, invoices, reminders,
# attendance rules, risk scores, monthly attendance report).
# Generated by `flask cron-tick-cronfile` from where the app really lives;
# don't hand-edit the paths. Install only after a reviewed
# `flask cron-tick --dry-run` (see DEPLOYMENT.md).
# One run at a time (Postgres advisory lock); each run appends one
# summary line ("cron-tick {...}") to the log below.
SHELL=/bin/sh
MAILTO=""
{{ minute }} {{ hour }} * * * {{ user }} cd {{ app_dir }} && FLASK_APP=wsgi.py {{ flask }} cron-tick >> {{ log_file }} 2>&1
