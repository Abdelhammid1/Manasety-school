# SAAS-029 — applies queued nginx syncs (console "sync now", new school,
# status / slug changes). The web app only queues; this unit runs the
# safety pipeline (backup → nginx -t → reload → verify → rollback).
# Paths below match the current layout; confirm before installing.
[Unit]
Description=Manasety nginx-sync (apply queued school server blocks)
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/manasety/lms
EnvironmentFile=/opt/manasety/lms/.env
Environment=FLASK_APP=wsgi.py
ExecStart=/opt/manasety/lms/venv/bin/flask nginx-sync --from-queue
TimeoutStartSec=600
