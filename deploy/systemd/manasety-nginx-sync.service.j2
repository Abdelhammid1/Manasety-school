# SAAS-029 / SAAS-040 - applies queued nginx syncs (console "sync now", new
# school, status / slug changes). The web app only queues; this unit runs
# the safety pipeline (backup -> nginx -t -> reload -> verify -> rollback).
# Generated by `flask nginx-sync-units` from where the app really lives;
# don't hand-edit the paths.
[Unit]
Description=Manasety nginx-sync (apply queued school server blocks)
After=network-online.target docker.service

[Service]
Type=oneshot
{%- if user %}
User={{ user }}
{%- endif %}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ env_file }}
Environment=FLASK_APP=wsgi.py
ExecStart={{ flask }} nginx-sync --from-queue
TimeoutStartSec=600
