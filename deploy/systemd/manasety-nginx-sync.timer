# SAAS-029 — every minute. Install:
#   cp deploy/systemd/manasety-nginx-sync.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now manasety-nginx-sync.timer
[Unit]
Description=Run manasety-nginx-sync every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
